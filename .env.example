# SilverNote configuration. Copy to `.env.local` and fill in what you have.
# Every value is optional: with nothing set, SilverNote runs on a built-in local
# Postgres (PGlite, stored in ./.silvernote/db) and free public market data.

# ─── Database ────────────────────────────────────────────────────────────────
# Leave empty to use the built-in local database.
# To use Supabase, paste the Postgres connection string from
# Supabase → Project Settings → Database → Connection string (Session pooler, port 5432).
DATABASE_URL=

# ─── Supabase Auth (single-user login) ───────────────────────────────────────
# When both are set, every page requires signing in. Leave empty for local use.
# Supabase → Project Settings → API: the project URL and the anon (public) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required with Supabase Auth: the only email allowed to sign in (and to create the first
# account). If it is empty, nobody can sign in.
OWNER_EMAIL=

# ─── Market data (all optional, free tiers are enough) ───────────────────────
# SEC asks automated clients to identify themselves with a contact email.
SEC_USER_AGENT="SilverNote personal research tool (contact@example.com)"
# https://finnhub.io  (free: real-time quotes, company & market news, peers, key metrics)
FINNHUB_API_KEY=
# https://financialmodelingprep.com  (free: 250 calls/day, profiles, standardized statements)
FMP_API_KEY=

# ─── Grok assistant ──────────────────────────────────────────────────────────
# https://console.x.ai  — the key stays on the server; it never reaches the browser.
XAI_API_KEY=
XAI_MODEL=grok-4
# Optional: model that reads portfolio screenshots on Portfolio → Import from photo
# (must accept images). Defaults to XAI_MODEL.
XAI_VISION_MODEL=

# ─── Notifications (optional) ────────────────────────────────────────────────
# Browser/phone push for alerts and briefs. Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Telegram: create a bot with @BotFather, message it once, then read your chat id from
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Scheduler ───────────────────────────────────────────────────────────────
# Protects /api/cron, which refreshes data, checks alerts and sends briefs without a browser open.
# Any long random string (openssl rand -hex 32). Vercel Cron and the GitHub workflow send it.
CRON_SECRET=
